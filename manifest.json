{
  "manifest_version": "0.4",
  "name": "codex",
  "display_name": "Codex",
  "version": "0.14.0",
  "description": "Run OpenAI codex as an interactive subagent on this machine \u2014 sessions with follow-up turns, per-turn JSON schemas, approvals routed to the caller. No configuration.",
  "author": {
    "name": "Alexander Stulov"
  },
  "server": {
    "type": "python",
    "entry_point": "server.py",
    "mcp_config": {
      "command": "python3",
      "args": [
        "${__dirname}/server.py"
      ],
      "platform_overrides": {
        "win32": {
          "command": "python"
        }
      }
    }
  },
  "tools": [
    {
      "name": "codex_check"
    },
    {
      "name": "codex_capabilities"
    },
    {
      "name": "codex_submit"
    },
    {
      "name": "codex_fork"
    },
    {
      "name": "codex_poll"
    },
    {
      "name": "codex_approve"
    },
    {
      "name": "codex_interrupt"
    },
    {
      "name": "codex_compact"
    }
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32"
    ]
  }
}
